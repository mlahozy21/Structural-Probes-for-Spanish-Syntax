\begin{frame}{À retenir}
  \textbf{Trois choses}
  \begin{enumerate}\setlength\itemsep{4pt}
    \item Réplication de la sonde structurelle de Hewitt-Manning sur
          l'espagnol : \alert{UUAS $0{,}76$ à la couche 7}, seulement
          $4$ points en dessous du pic anglais.
    \item Documentation de \alert{trois pièges de réplication} qui
          empoisonnaient silencieusement le pipeline ($+51\%$ d'UUAS
          en les corrigeant).
    \item Introduction de la \emph{sonde isométrique} : une chute de
          $-64\%$ d'UUAS montre que la géométrie syntaxique est
          \alert{étirable, pas rigide} (effet Pancake, $\kappa = 3{,}74$).
  \end{enumerate}

