% =====================================================================
% 2a. Le langage est arborescent
% =====================================================================
\begin{frame}{Le langage est \emph{arborescent}}
  \begin{columns}[T]
    \column{0.5\textwidth}
    \vspace{0.3cm}
    Les linguistes décrivent les phrases comme des \alert{arbres
    de dépendances} :
    \begin{itemize}\setlength\itemsep{4pt}
      \item un \emph{verbe} gouverne un sujet, un objet, des modificateurs ;
      \item chaque mot est lié à son \emph{tête} syntaxique ;
      \item la structure est \alert{récursive} et \alert{hiérarchique}.
    \end{itemize}

    \vspace{0.4cm}
    \footnotesize
    Cette représentation, héritée de Chomsky (\textit{Syntactic Structures},
    1957), est la base de presque toute l'analyse syntaxique moderne.

    \column{0.48\textwidth}
    \centering
    \vspace{0.3cm}
    \begin{tikzpicture}[scale=1.0, every node/.style={font=\small}]
      \node (v) at (0,3) {\textbf{ate}};
      \node (s) at (-1.8,2) {\textbf{cat}};
      \node (a) at (-1.8,1) {The};
      \node (o) at (1.8,2) {\textbf{fish}};
      \node (b) at (1.8,1) {the};
      \draw[thick] (v) -- (s);
      \draw[thick] (v) -- (o);
      \draw[thick] (s) -- (a);
      \draw[thick] (o) -- (b);
      \node[gray] at (0,3.7) {Arbre de dépendances};
      \node[gray, font=\footnotesize] at (0,0.3) {« The cat ate the fish »};
      \node[gray, font=\scriptsize, anchor=east] at (-1.85,1.5) {det};
      \node[gray, font=\scriptsize, anchor=east] at (-0.55,2.5) {sujet};
      \node[gray, font=\scriptsize, anchor=west] at (0.55,2.5) {objet};
      \node[gray, font=\scriptsize, anchor=west] at (1.85,1.5) {det};
    \end{tikzpicture}
  \end{columns}
\end{frame}

% =====================================================================
% 2b. Avant BERT : analyse supervisée
% =====================================================================
\begin{frame}{Avant BERT : on \emph{enseignait} la syntaxe au modèle}
  \begin{columns}[T]
    \column{0.55\textwidth}
    Pendant des décennies, l'analyse syntaxique était une tâche
    \alert{entièrement supervisée}.

    \vspace{0.3cm}
    \textbf{Recette classique :}
    \begin{enumerate}\setlength\itemsep{4pt}
      \item annoter à la main des milliers de phrases avec leur arbre
            (Penn Treebank, 1993 : 4{,}5 M de mots) ;
      \item entraîner un analyseur sur ces arbres
            (Collins, Charniak, \ldots) ;
      \item évaluer sur des phrases nouvelles.
    \end{enumerate}

    \vspace{0.3cm}
    \textbf{Limites :}
    \begin{itemize}\setlength\itemsep{2pt}
      \item annotation \alert{coûteuse} (mois d'experts par treebank) ;
      \item \alert{biais de domaine} (Wall Street Journal\ldots) ;
      \item difficile à généraliser à d'autres langues.
    \end{itemize}

    \column{0.43\textwidth}
    \centering
    \vspace{0.4cm}
    \begin{tikzpicture}[scale=0.85, every node/.style={font=\footnotesize}]
      % Mini "annotated example"
      \node[draw, fill=gray!10, rounded corners, text width=4.6cm,
            inner sep=6pt] (box) at (0,0) {%
        \textbf{Exemple annoté}\\[3pt]
        \texttt{1\quad The\quad DET\quad 2}\\
        \texttt{2\quad cat\quad NOUN\quad 3}\\
        \texttt{3\quad ate\quad VERB\quad 0}\\
        \texttt{4\quad the\quad DET\quad 5}\\
        \texttt{5\quad fish\quad NOUN\quad 3}\\[3pt]
        \scriptsize\textcolor{gray}{(format CoNLL : mot, POS, tête)}};
      \node[gray, font=\scriptsize, anchor=north] at (0,-2.2)
        {\emph{une ligne par mot, une vie par treebank.}};
    \end{tikzpicture}
  \end{columns}
\end{frame}

% =====================================================================
% 2c. BERT et l'énigme
% =====================================================================
\begin{frame}{BERT (2019) : ni arbres, ni étiquettes \ldots et pourtant}
  \begin{columns}[T]
    \column{0.55\textwidth}
    \alert{BERT} change la donne. Entraîné uniquement sur la
    \alert{prédiction de tokens masqués} sur des milliards de mots
    bruts, sans aucune annotation linguistique.

    \medskip
    \emph{Il ne voit jamais un seul arbre syntaxique pendant le
    pré-entraînement.}

    \vspace{0.4cm}
    Et pourtant, il gère :
    \begin{itemize}\setlength\itemsep{2pt}
      \item l'accord à longue distance,
      \item les dépendances hiérarchiques,
      \item la cohérence inter-phrastique,
      \item la résolution d'ambiguïtés syntaxiques.
    \end{itemize}

    \vspace{0.4cm}
    \large
    \alert{Où se cache la syntaxe ?}

    \column{0.43\textwidth}
    \centering
    \vspace{0.6cm}
    \begin{tikzpicture}[scale=0.85, every node/.style={font=\footnotesize}]
      \node[font=\small] at (0,2.5) {\textbf{Tâche de pré-entraînement}};
      \node[draw, fill=gray!10, rounded corners, text width=5.2cm,
            inner sep=8pt, font=\ttfamily\small] at (0,1.5)
        {The cat ate the [MASK].};
      \draw[->, thick, accent] (0,0.7) -- (0,0.1);
      \node[font=\small] at (0,-0.3) {prédire \texttt{fish}};
      \node[gray, font=\scriptsize] at (0,-0.9)
        {(une tâche, des milliards de fois)};

      \draw[dashed, gray] (-2.6,-1.4) -- (2.6,-1.4);
      \node[font=\scriptsize, gray, text width=5cm, align=center] at (0,-2.0)
        {\emph{Aucune information sur les arbres,\\ les têtes, les rôles syntaxiques.}};
    \end{tikzpicture}
  \end{columns}
\end{frame}

% =====================================================================
% 3. Brève histoire
% =====================================================================
\begin{frame}{Brève histoire de la syntaxe en TAL}
  \centering
  \vspace{0.3cm}
  \begin{tikzpicture}[every node/.style={font=\footnotesize}]
    \draw[->, very thick, gray] (-0.3,0) -- (12.3,0);
    \foreach \x/\y in {0/1957, 3/1993, 6/2013, 9/2018-19, 12/2026}
      \draw[gray] (\x,-0.15) -- (\x,0.15) node[above=2pt, gray] {\y};
    \node[align=center, anchor=north, text width=2.6cm] at (0,-0.3)
      {\textbf{Chomsky}\\[1pt]Phrases = arbres, grammaire générative};
    \node[align=center, anchor=north, text width=2.6cm] at (3,-0.3)
      {\textbf{Penn Treebank}\\[1pt]Analyse supervisée sur arbres annotés};
    \node[align=center, anchor=north, text width=2.6cm] at (6,-0.3)
      {\textbf{word2vec}\\[1pt]Structure linguistique = géométrie vectorielle};
    \node[align=center, anchor=north, text width=2.6cm] at (9,-0.3)
      {\textbf{BERT}\\[1pt]Auto-supervisé, sans arbres syntaxiques};
    \node[align=center, anchor=north, text width=2.6cm, accent] at (12,-0.3)
      {\textbf{Aujourd'hui}\\[1pt]Connaissent-ils la syntaxe \emph{quand même} ?};
  \end{tikzpicture}

  \vspace{2.4cm}

  \begin{itemize}
    \item Avant 2018 : on \emph{enseigne} la syntaxe au modèle (supervision).
    \item Après BERT : le modèle n'est \emph{jamais informé} --- mais semble
          se comporter comme s'il la connaissait.
    \item \alert{Le \emph{probing}} = l'outil standard pour découvrir ce
          que le modèle a réellement appris.
  \end{itemize}
\end{frame}

% =====================================================================
% 4. Qu'est-ce qu'une sonde ?
% =====================================================================
\begin{frame}{Qu'est-ce qu'une \emph{sonde} (probe) ?}
  \begin{columns}[T]
    \column{0.5\textwidth}
    \textbf{Le principe}\\[4pt]
    On prend un modèle pré-entraîné et figé. On entraîne au-dessus
    une \alert{petite tête supervisée} sur l'une de ses couches
    cachées, pour prédire une propriété linguistique
    (POS, arête de dépendance, distance syntaxique).

    \vspace{0.4cm}
    \textbf{Pourquoi « petite » ?}\\[4pt]
    Si une sonde \emph{simple} réussit, alors la propriété est déjà
    \alert{linéairement récupérable} dans la représentation.
    Une tête trop grande peut tout apprendre --- on la garde minimale
    par construction.

    \vspace{0.4cm}
    \footnotesize
    Outil standard en interprétabilité
    (Ethayarajh, Hewitt-Liang, Voita-Titov\ldots).

    \column{0.48\textwidth}
    \centering
    \vspace{0.2cm}
    \begin{tikzpicture}[scale=0.85, every node/.style={font=\footnotesize}]
      \foreach \i/\lab in {0/Couche 1, 1/Couche 2, 2/$\vdots$, 3/Couche 7, 4/$\vdots$, 5/Couche 12} {
        \draw[fill=frozenblue!20, draw=frozenblue]
          (-1.4, 0.55*\i) rectangle (1.4, 0.55*\i+0.45);
        \node[font=\scriptsize] at (0, 0.55*\i+0.22) {\lab};
      }
      \node[font=\small, anchor=south] at (0, 3.4) {Modèle \textbf{figé}};
      \node[font=\Large] at (-2.0, 1.65) {$\boxtimes$};
      \node[font=\scriptsize, gray] at (-2.4, 1.0) {(pas de gradient)};

      \draw[->, thick, accent] (1.45, 1.87) -- (3.0, 1.87);

      \draw[fill=probegreen!25, draw=probegreen, thick]
        (3.0, 1.4) rectangle (5.4, 2.4);
      \node[font=\small] at (4.2, 1.9) {\textbf{Sonde} ($B$)};
      \node[font=\scriptsize, gray] at (4.2, 1.65) {petite, entraînable};

      \draw[->, thick, accent] (5.45, 1.9) -- (6.5, 1.9);
      \node[anchor=west, font=\scriptsize, align=left] at (6.5, 1.9)
        {prédire les\\ distances de l'arbre};
    \end{tikzpicture}
  \end{columns}
\end{frame}

% =====================================================================
% 5. Hewitt & Manning hypothèse
% =====================================================================
\begin{frame}{Hewitt \& Manning, NAACL 2019 : la sonde structurelle}
  \begin{columns}[T]
    \column{0.55\textwidth}
    \textbf{Idée.} Entraîner une projection linéaire $B$ sur BERT figé,
    de sorte que la distance euclidienne au carré entre deux vecteurs
    de mots approxime leur \alert{distance dans l'arbre syntaxique}.

    \medskip
    \textbf{Hypothèse.} Il existe $B \in \mathbb{R}^{r\times d}$ tel
    que :
    \[
      \widehat{d}_{ij} \;=\; \lVert B(h_i - h_j) \rVert_2^2
      \;\approx\; d_T(w_i, w_j)
    \]

    \footnotesize
    Entraînement de $B$ par régression $\ell_1$ sur les distances de
    l'arbre.\\[2pt]
    Aucune information syntaxique pendant le pré-entraînement.\\[2pt]
    Métriques : \textbf{Spearman} $\rho$ et \textbf{UUAS} (score
    d'attachement non-étiqueté).

    \column{0.43\textwidth}
    \begin{tikzpicture}[scale=0.85, every node/.style={font=\footnotesize}]
      \node (v) at (0,2) {verb};
      \node (s) at (-1.1,1) {subj};
      \node (o) at (1.1,1) {obj};
      \draw (v) -- (s);
      \draw (v) -- (o);
      \node[gray] at (0,2.6) {arbre vrai};

      \draw[->, thick, accent] (1.6,1.5) -- (3.4,1.5)
        node[midway, above, black] {\scriptsize sonde $B$};

      \node at (4.7,2.6) {$\hat d$ prédit};
      \foreach \i/\j/\v in {%
        0/0/0, 0/1/1, 0/2/1,
        1/0/1, 1/1/0, 1/2/2,
        2/0/1, 2/1/2, 2/2/0}
        {\node[draw=gray!40, minimum size=12pt, inner sep=1pt]
          at ({4.1 + 0.45*\j}, {1.9 - 0.4*\i}) {\v};}
    \end{tikzpicture}
  \end{columns}
\end{frame}

% =====================================================================
% 6. Résultats H&M sur l'anglais
% =====================================================================
\begin{frame}{Leur résultat sur l'anglais : BERT \emph{encode bien} la syntaxe}
  \centering
  \includegraphics[width=0.78\textwidth]{figures/hm_english_results.jpg}

  \vspace{0.2cm}
  \footnotesize
  \begin{itemize}\setlength\itemsep{2pt}
    \item BERT-base couche 7 : \alert{UUAS $0{,}80$}, Spearman $0{,}85$
          --- proche des analyseurs entièrement supervisés, sans aucun
          entraînement syntaxique.
    \item Courbe en cloche sur les couches (pic au milieu), confirmé
          pour PTB anglais.
    \item Baseline linéaire (sans contextualisation) : $\sim 0{,}49$ UUAS.
  \end{itemize}
  $\Rightarrow$ la syntaxe \emph{vit} dans la géométrie de BERT, du moins
  en anglais.
\end{frame}

% =====================================================================
% 7. Ce que nous ajoutons
% =====================================================================
\begin{frame}{Ce que nous ajoutons}
  Hewitt \& Manning ont répondu à la question sur \alert{BERT anglais}.
  Deux suites naturelles restent ouvertes :

  \vspace{0.4cm}
  \begin{enumerate}\setlength\itemsep{8pt}
    \item \textbf{Transfert cross-lingue.} La même géométrie syntaxique
          existe-t-elle dans \alert{BERT multilingue} pour des langues
          autres que l'anglais ? Concrètement : fonctionne-t-elle sur
          \alert{l'espagnol} via mBERT ?
    \item \textbf{Géométrie vs.\ traits.} L'arbre syntaxique est-il une
          \alert{forme rigide} dans l'espace de représentation, ou des
          \alert{traits} que la sonde doit amplifier par des
          étirements non uniformes ?
  \end{enumerate}

  \vspace{0.5cm}
  Nos deux contributions répondent à ces deux questions :
  \begin{itemize}
    \item Réplication couche par couche sur \ancora.
    \item \textbf{Sonde isométrique} --- une variante contrainte qui
          isole la rotation de l'étirement.
  \end{itemize}
\end{frame}

% =====================================================================
% 8. La sonde isométrique
% =====================================================================
\begin{frame}{Contribution : la sonde \emph{isométrique}}
  La sonde linéaire \alert{tourne et étire} l'espace mBERT.
  Deux opérations entremêlées. \quad \textbf{Question :} laquelle compte ?

  \vspace{0.5cm}
  \textbf{Sonde isométrique :} contraindre la projection à être orthogonale.
  \[
    B_\mathrm{iso} B_\mathrm{iso}^\top \;=\; I_r
    \qquad \Longrightarrow \qquad
    \kappa(B_\mathrm{iso}) = 1, \;\; \text{rotation seule}
  \]

  \vspace{0.3cm}
  \begin{itemize}
    \item Si la syntaxe est une \alert{forme rigide} dans l'espace mBERT
          $\;\to\;$ l'isométrique doit égaler la sonde linéaire.
    \item Si la syntaxe nécessite un \alert{étirement anisotrope}
          $\;\to\;$ l'isométrique s'effondre.
  \end{itemize}

  \vfill
  \footnotesize
  \emph{Implémentation :} \texttt{torch.nn.utils.parametrizations.orthogonal}
  appliqué à la couche de projection.
\end{frame}

